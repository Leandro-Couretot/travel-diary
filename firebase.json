{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "functions/**",
      "node_modules/**",
      "CLAUDE.md",
      "*.md"
    ],
    "rewrites": [
      { "source": "/api/auth/session", "function": "authSession" },
      { "source": "/api/checkout/create", "function": "checkoutCreate" },
      { "source": "/api/subscription/status", "function": "subscriptionStatus" },
      { "source": "/api/webhooks/mercadopago", "function": "webhookMercadopago" },
      { "source": "/api/track", "function": "trackEvent" },
      { "source": "/api/drive/token/refresh", "function": "driveTokenRefresh" },
      { "source": "/:slug", "function": "campaignLink" }
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "**/*.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/version.json",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ]
}
